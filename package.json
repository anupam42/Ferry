{
  "name": "ferry",
  "version": "1.2.0",
  "description": "Mirror a working folder into a git repo (and back) from any terminal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ferry": "src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --compile --minify --sourcemap --outfile dist/ferry"
  },
  "dependencies": {
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
