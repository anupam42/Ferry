{
  "name": "ferry",
  "version": "1.2.0",
  "description": "Mirror a working folder into a git repo (and back) from any terminal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ferry": "src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun src/main.ts ui --dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "bun scripts/build-web.ts && bun build src/main.ts --compile --minify --sourcemap --outfile dist/ferry",
    "build:web": "bun scripts/build-web.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "sass": "^1.108.1",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2"
  }
}
